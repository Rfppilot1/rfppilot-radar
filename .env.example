# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
SAM_API_KEY=            # free key from SAM.gov > Account Details > Public API Key
RADAR_API_KEYS=         # comma-separated "tenantId:key" pairs, e.g. isf:dev-key-change-me
ANTHROPIC_API_KEY=      # optional: enables the Claude relevance reviewer
RADAR_USER_AGENT=RFPPilotRadar/0.1 (+https://rfppilot.com; ben@rfppilot.com)
RESEND_API_KEY=         # optional: enables the daily email digest
RADAR_EMAIL_FROM=       # e.g. Radar <radar@rfppilot.com>; the domain must be verified in Resend
RADAR_SAM_STATES=FL,TX
RADAR_MAX_REVIEWS=50
RADAR_UNSUBSCRIBE_EMAIL= # mailbox that receives List-Unsubscribe requests, e.g. radar-unsubscribe@rfppilot.com

# Operator-set digest recipients: tenant/profile=a@x.com,b@y.com;tenant2/profile2=c@z.com
RADAR_RECIPIENTS=
RADAR_ALERT_EMAIL=      # operator address for the after-run problem list
RADAR_SOURCE_DEADLINE_MIN=45
