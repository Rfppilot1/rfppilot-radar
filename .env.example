# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
SAM_API_KEY=            # free key from SAM.gov > Account Details > Public API Key
RADAR_API_KEYS=         # comma-separated "tenantId:key" pairs, e.g. isf:dev-key-change-me
ANTHROPIC_API_KEY=      # optional: enables the Claude relevance reviewer
RADAR_USER_AGENT=RFPPilotRadar/0.1 (+https://rfppilot.com; ben@rfppilot.com)
