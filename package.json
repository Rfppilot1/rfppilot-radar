{
  "name": "rfppilot-radar",
  "private": true,
  "version": "0.1.0",
  "description": "RFP Pilot Radar: finds, scores and routes public-sector opportunities into RFP Pilot.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter '!@radar/web' run build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm test",
    "build:web": "pnpm --filter @radar/web build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "body-parser": "^2.4.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
